{
  "name": "cx",
  "displayName": "C+",
  "description": "C+ language support",
  "version": "0.2.1",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cx",
        "icon": {
          "dark": "cplus-icon.png",
          "light": "cplus-icon.png"
        },
        "aliases": [
          "C+",
          "c+"
        ],
        "extensions": [
          ".c+",
          ".cp"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "hx",
        "aliases": [
          "C+ Header"
        ],
        "extensions": [
          ".h+",
          ".hp"
        ],
        "icon": {
          "dark": "cplus-header-icon.png",
          "light": "cplus-header-icon.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cx",
        "scopeName": "source.cx",
        "path": "./syntaxes/cx.tmLanguage.json"
      },
      {
        "language": "hx",
        "scopeName": "source.cx",
        "path": "./syntaxes/cx.tmLanguage.json"
      }
    ]
  },
  "repository": {
    "url": "https://github.com/Sonnigg/cplus"
  },
  "icon": "cplus-icon.png"
}