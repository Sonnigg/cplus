#ifndef _FS_HP
#define _FS_HP

#include <types>
#include <memory>
#include <string>
#include <io>
#include <internal/_utilities>
// For stringLength
#include <chars>

#ifdef _WIN32
#include <windows.h>
#else
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>
#include <stdlib.h>
#include <stdio.h>
#endif

namespace std
{
    enum FileMode
    {
        Read,
        Write,
        Append
    };

    struct DirectoryEntry
    {
        std::String name;
        std::String fullPath;
        bool isFile;
        bool isDirectory;
        std::size_t size;

        inline void destroy(DirectoryEntry *self)
        {
            if (!self) return;
            self->name.destroy();
            self->fullPath.destroy();
        }
    };

    struct File
    {
#ifdef _WIN32
        void* __handle; // Represents HANDLE in Windows
#else
        int   __fd;     // Represents file descriptor in POSIX
#endif
        bool  __isOpen;
        std::FileMode __mode;
        bool  __deleteOnClose;
        char  __path[1024];

        static inline File empty()
        {
#ifdef _WIN32
            return File { __handle: nullptr, __isOpen: false, __mode: std::FileMode::Read, __deleteOnClose: false, __path: {0} };
#else
            return File { __fd: 0, __isOpen: false, __mode: std::FileMode::Read, __deleteOnClose: false, __path: {0} };
#endif
        }

        static inline bool remove(const char *path)
        {
            if (!path) return false;
#ifdef _WIN32
            return DeleteFileA(path) != 0;
#else
            return unlink(path) == 0;
#endif
        }

        inline void closeFile(File *self)
        {
            if (!self || !self->__isOpen)
                return;

#ifdef _WIN32
            CloseHandle(self->__handle);
            self->__handle = nullptr;
#else
            close(self->__fd);
            self->__fd = -1;
#endif
            self->__isOpen = false;

            if (self->__deleteOnClose && self->__path[0] != '\0')
            {
                File::remove(self->__path);
            }
        }

        static inline File openFile(const char *const _chpPath, std::FileMode _mode)
        {
            File f;
            f.__isOpen = false;
            f.__mode = _mode;
            f.__deleteOnClose = false;
            f.__path[0] = '\0';

            if (!_chpPath)
                return f;

            std::size_t pLen = std::stringLength(_chpPath);
            if (pLen < 1024)
            {
                for (std::size_t i = 0; i <= pLen; i++)
                    f.__path[i] = _chpPath[i];
            }

#ifdef _WIN32
            DWORD dwDesiredAccess = 0;
            DWORD dwCreationDisposition = 0;

            switch (_mode)
            {
                case std::FileMode::Read:
                    dwDesiredAccess = GENERIC_READ;
                    dwCreationDisposition = OPEN_EXISTING;
                case std::FileMode::Write:
                    dwDesiredAccess = GENERIC_WRITE;
                    dwCreationDisposition = CREATE_ALWAYS;
                case std::FileMode::Append:
                    dwDesiredAccess = FILE_APPEND_DATA;
                    dwCreationDisposition = OPEN_ALWAYS;
            }

            f.__handle = CreateFileA(
                _chpPath, 
                dwDesiredAccess, 
                FILE_SHARE_READ, 
                nullptr, 
                dwCreationDisposition, 
                FILE_ATTRIBUTE_NORMAL, 
                nullptr
            );

            if (f.__handle != INVALID_HANDLE_VALUE)
            {
                f.__isOpen = true;
            }
#else
            int flags = 0;
            mode_t file_mode = S_IRUSR | S_IWUSR | S_IRGRP | S_IROTH;

            switch (_mode)
            {
                case std::FileMode::Read:
                    flags = O_RDONLY;
                case std::FileMode::Write:
                    flags = O_WRONLY | O_CREAT | O_TRUNC;
                case std::FileMode::Append:
                    flags = O_WRONLY | O_CREAT | O_APPEND;
            }

            f.__fd = open(_chpPath, flags, file_mode);
            if (f.__fd >= 0)
            {
                f.__isOpen = true;
            }
#endif
            return f;
        }

        inline std::size_t readFile(File *self, char *const _chpBuffer, std::size_t _szLength)
        {
            if (!self || !self->__isOpen || !_chpBuffer || _szLength == 0)
                return 0;

#ifdef _WIN32
            DWORD bytesRead = 0;
            if (ReadFile(self->__handle, _chpBuffer, static_cast<DWORD>(_szLength), &bytesRead, nullptr))
            {
                return static_cast<std::size_t>(bytesRead);
            }
            return 0;
#else
            std::ssize_t bytesRead = read(self->__fd, _chpBuffer, _szLength);
            if (bytesRead > 0)
            {
                return static_cast<std::size_t>(bytesRead);
            }
            return 0;
#endif
        }

        inline std::size_t _writeFile(File *self, const char *const _chpBuffer, std::size_t _szLength)
        {
            if (!self || !self->__isOpen || !_chpBuffer || _szLength == 0)
                return 0;

#ifdef _WIN32
            DWORD bytesWritten = 0;
            if (WriteFile(self->__handle, _chpBuffer, static_cast<DWORD>(_szLength), &bytesWritten, nullptr))
            {
                return static_cast<std::size_t>(bytesWritten);
            }
            return 0;
#else
            std::ssize_t bytesWritten = write(self->__fd, _chpBuffer, _szLength);
            if (bytesWritten > 0)
            {
                return static_cast<std::size_t>(bytesWritten);
            }
            return 0;
#endif
        }

        inline std::size_t writeFile(File *self, const char *const _chpBuffer)
        {
            if (!self || !self->__isOpen || !_chpBuffer)
                return 0;
            std::size_t _szLength = std::stringLength(_chpBuffer);
            if (_szLength == 0)
                return 0;
            return self->_writeFile(_chpBuffer, _szLength);
        }

        inline std::String readAll(File *self)
        {
            if (!self || !self->__isOpen)
                return std::String::new();

            std::size_t capacity = 4096;
            std::size_t length = 0;
            
            char *buffer = static_cast<char *>(std::allocateMemory(capacity));
            if (!buffer)
            {
                std::errputs("Out of Memory, returning empty string (File::readAll).");
                return std::String::new();
            }

            while (true)
            {
                if (capacity - length < 1024)
                {
                    std::size_t newCapacity = capacity * 2;
                    char *newBuffer = static_cast<char *>(std::reallocateMemory(buffer, newCapacity));
                    if (!newBuffer)
                    {
                        std::errputs("Out of Memory during read, returning what was read so far (File::readAll).");
                        break;
                    }
                    buffer = newBuffer;
                    capacity = newCapacity;
                }

                std::size_t bytesRead = self->readFile(buffer + length, capacity - length - 1);
                
                if (bytesRead == 0)
                    break;

                length += bytesRead;
            }

            buffer[length] = '\0';

            std::String out;
            out.__data = buffer;
            out.__len = length;
            out.__cap = capacity;

            return out;
        }

        inline bool isOpen(const File *self)
        {
            return self ? self->__isOpen : false;
        }

        inline bool isReadable(const File *self)
        {
            if (!self || !self->__isOpen) return false;
            return self->__mode == std::FileMode::Read;
        }

        inline bool isWritable(const File *self)
        {
            if (!self || !self->__isOpen) return false;
            return self->__mode == std::FileMode::Write || self->__mode == std::FileMode::Append;
        }

        inline bool seekFromStart(File *self, std::size_t offset)
        {
            if (!self || !self->__isOpen) return false;
#ifdef _WIN32
            DWORD res = SetFilePointer(self->__handle, static_cast<LONG>(offset), nullptr, FILE_BEGIN);
            return res != INVALID_SET_FILE_POINTER;
#else
            return lseek(self->__fd, static_cast<off_t>(offset), SEEK_SET) != -1;
#endif
        }

        inline bool seek(File *self, std::size_t offset)
        {
            return self->seekFromStart(offset);
        }

        inline bool seekFromEnd(File *self, std::size_t offset)
        {
            if (!self || !self->__isOpen) return false;
#ifdef _WIN32
            DWORD res = SetFilePointer(self->__handle, static_cast<LONG>(offset), nullptr, FILE_END);
            return res != INVALID_SET_FILE_POINTER;
#else
            return lseek(self->__fd, static_cast<off_t>(offset), SEEK_END) != -1;
#endif
        }

        inline bool seekRelative(File *self, std::ptrsize_t offset)
        {
            if (!self || !self->__isOpen) return false;
#ifdef _WIN32
            DWORD res = SetFilePointer(self->__handle, static_cast<LONG>(offset), nullptr, FILE_CURRENT);
            return res != INVALID_SET_FILE_POINTER;
#else
            return lseek(self->__fd, static_cast<off_t>(offset), SEEK_CUR) != -1;
#endif
        }

        inline std::size_t tell(File *self)
        {
            if (!self || !self->__isOpen) return 0;
#ifdef _WIN32
            DWORD pos = SetFilePointer(self->__handle, 0, nullptr, FILE_CURRENT);
            return pos == INVALID_SET_FILE_POINTER ? 0 : static_cast<std::size_t>(pos);
#else
            off_t pos = lseek(self->__fd, 0, SEEK_CUR);
            return pos == -1 ? 0 : static_cast<std::size_t>(pos);
#endif
        }

        inline std::size_t size(File *self)
        {
            if (!self || !self->__isOpen) return 0;
#ifdef _WIN32
            DWORD sz = GetFileSize(self->__handle, nullptr);
            return sz == INVALID_FILE_SIZE ? 0 : static_cast<std::size_t>(sz);
#else
            struct stat st;
            if (fstat(self->__fd, &st) == 0)
            {
                return static_cast<std::size_t>(st.st_size);
            }
            return 0;
#endif
        }

        inline bool isEOF(File *self)
        {
            if (!self || !self->__isOpen) return true;
            return self->tell() >= self->size();
        }

        inline bool readBytes(File *self, void *buffer, std::size_t count)
        {
            if (!self || !self->__isOpen || !buffer) return false;
            return self->readFile(static_cast<char*>(buffer), count) == count;
        }

        inline char readByte(File *self)
        {
            char c = 0;
            if (self->readBytes(&c, 1))
                return c;
            return 0;
        }

        inline std::String readUntil(File *self, char delimiter)
        {
            if (!self || !self->__isOpen) return std::String::new();

            std::size_t capacity = 128;
            std::size_t length = 0;
            char *buf = static_cast<char*>(std::allocateMemory(capacity));
            if (!buf) return std::String::new();

            while (!self->isEOF())
            {
                char c = self->readByte();
                if (c == 0 && self->isEOF()) break;

                if (length + 2 >= capacity)
                {
                    capacity *= 2;
                    char *newBuf = static_cast<char*>(std::reallocateMemory(buf, capacity));
                    if (!newBuf) break;
                    buf = newBuf;
                }

                if (c == delimiter) break;
                buf[length++] = c;
            }

            buf[length] = '\0';
            std::String out;
            out.__data = buf;
            out.__len = length;
            out.__cap = capacity;
            return out;
        }

        inline std::String readLine(File *self)
        {
            return self->readUntil('\n');
        }

        inline bool skipWhitespace(File *self)
        {
            if (!self || !self->__isOpen) return false;
            while (!self->isEOF())
            {
                char c = self->readByte();
                if (c != ' ' && c != '\t' && c != '\n' && c != '\r')
                {
                    self->seekRelative(-1);
                    return true;
                }
            }
            return false;
        }

        inline std::String readWord(File *self)
        {
            if (!self || !self->__isOpen) return std::String::new();
            self->skipWhitespace();

            std::size_t capacity = 64;
            std::size_t length = 0;
            char *buf = static_cast<char*>(std::allocateMemory(capacity));
            if (!buf) return std::String::new();

            while (!self->isEOF())
            {
                char c = self->readByte();
                if (c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == 0)
                {
                    break;
                }

                if (length + 2 >= capacity)
                {
                    capacity *= 2;
                    char *newBuf = static_cast<char*>(std::reallocateMemory(buf, capacity));
                    if (!newBuf) break;
                    buf = newBuf;
                }

                buf[length++] = c;
            }

            buf[length] = '\0';
            std::String out;
            out.__data = buf;
            out.__len = length;
            out.__cap = capacity;
            return out;
        }

        inline bool skip(File *self, std::size_t bytes)
        {
            return self->seekRelative(static_cast<std::ptrsize_t>(bytes));
        }

        inline bool writeBytes(File *self, const void *buffer, std::size_t count)
        {
            if (!self || !self->__isOpen || !buffer) return false;
            return self->_writeFile(static_cast<const char*>(buffer), count) == count;
        }

        inline bool writeByte(File *self, char c)
        {
            return self->writeBytes(&c, 1);
        }

        inline bool writeLine(File *self, const char *text)
        {
            if (!self || !self->__isOpen) return false;
            if (text)
            {
                std::size_t len = std::stringLength(text);
                if (len > 0 && self->_writeFile(text, len) != len) return false;
            }
            return self->writeByte('\n');
        }

        inline bool writeString(File *self, const std::String *text)
        {
            if (!self || !self->__isOpen || !text || !text->__data) return false;
            return self->_writeFile(text->__data, text->__len) == text->__len;
        }

        inline bool flush(File *self)
        {
            if (!self || !self->__isOpen) return false;
#ifdef _WIN32
            return FlushFileBuffers(self->__handle) != 0;
#else
            return fsync(self->__fd) == 0;
#endif
        }

        inline bool resize(File *self, std::size_t newSize)
        {
            if (!self || !self->__isOpen) return false;
#ifdef _WIN32
            std::size_t oldPos = self->tell();
            if (!self->seekFromStart(newSize)) return false;
            BOOL ok = SetEndOfFile(self->__handle);
            self->seekFromStart(oldPos);
            return ok != 0;
#else
            return ftruncate(self->__fd, static_cast<off_t>(newSize)) == 0;
#endif
        }

        inline bool truncate(File *self)
        {
            if (!self || !self->__isOpen) return false;
            return self->resize(self->tell());
        }

        inline bool removeOnClose(File *self)
        {
            if (!self) return false;
            self->__deleteOnClose = true;
            return true;
        }

        static inline bool exists(const char *const _chpPath)
        {
            if (!_chpPath) return false;

#ifdef _WIN32
            DWORD attrib = GetFileAttributesA(_chpPath);
            return (attrib != INVALID_FILE_ATTRIBUTES && !(attrib & FILE_ATTRIBUTE_DIRECTORY));
#else
            struct stat st;
            if (stat(_chpPath, &st) == 0)
            {
                return S_ISREG(st.st_mode) || S_ISLNK(st.st_mode);
            }
            return false;
#endif
        }

        static inline bool writeAll(const char *const _chpPath, const char *const _chpContent)
        {
            if (!_chpPath || !_chpContent) return false;

            File f = File::openFile(_chpPath, std::FileMode::Write);
            if (!f.__isOpen) return false;
            defer { f.closeFile(); }

            std::size_t len = std::stringLength(_chpContent);
            std::size_t written = f._writeFile(_chpContent, len);
            
            return written == len;
        }

        static inline bool appendFile(const char *const _chpPath, const char *const _chpContent)
        {
            if (!_chpPath || !_chpContent) return false;

            File f = File::openFile(_chpPath, std::FileMode::Append);
            if (!f.__isOpen) return false;
            defer { f.closeFile(); }

            std::size_t len = std::stringLength(_chpContent);
            std::size_t written = f._writeFile(_chpContent, len);
            
            return written == len;
        }

        static inline bool replaceInFile(const char *const _chpPath, const char *const _chpSearch, const char *const _chpReplace)
        {
            if (!_chpPath || !_chpSearch || !_chpReplace) return false;

            std::size_t searchLen = std::stringLength(_chpSearch);
            if (searchLen == 0) return false;

            File inFile = File::openFile(_chpPath, std::FileMode::Read);
            if (!inFile.__isOpen) return false;
            defer { inFile.closeFile(); }
            
            std::String content = inFile.readAll();
            defer { content.destroy(); }

            if (!content.__data || content.__len == 0) return false;

            std::String newContent = std::String::new();
            defer { newContent.destroy(); }

            char *curr = content.__data;
            char *end = content.__data + content.__len;

            while (curr < end)
            {
                bool match = false;
                if (static_cast<std::size_t>(end - curr) >= searchLen)
                {
                    match = true;
                    for (std::size_t i = 0; i < searchLen; i++)
                    {
                        if (curr[i] != _chpSearch[i])
                        {
                            match = false;
                            break;
                        }
                    }
                }

                if (match)
                {
                    newContent.appendChars(_chpReplace);
                    curr += searchLen;
                }
                else
                {
                    char tmp[2] = { *curr, '\0' };
                    newContent.appendChars(tmp);
                    curr++;
                }
            }

            File outFile = File::openFile(_chpPath, std::FileMode::Write);
            if (!outFile.__isOpen) return false;
            defer { outFile.closeFile(); }
            
            outFile._writeFile(newContent.__data, newContent.__len);
            
            return true;
        }

        static inline bool copy(const char *src, const char *dst)
        {
            if (!src || !dst) return false;
#ifdef _WIN32
            return CopyFileA(src, dst, FALSE) != 0;
#else
            File fSrc = File::openFile(src, std::FileMode::Read);
            if (!fSrc.__isOpen) return false;
            defer { fSrc.closeFile(); }

            File fDst = File::openFile(dst, std::FileMode::Write);
            if (!fDst.__isOpen) return false;
            defer { fDst.closeFile(); }

            char buf[4096];
            std::size_t bytesRead = 0;
            bool ok = true;
            while ((bytesRead = fSrc.readFile(buf, sizeof(buf))) > 0)
            {
                if (fDst._writeFile(buf, bytesRead) != bytesRead)
                {
                    ok = false;
                    break;
                }
            }
            return ok;
#endif
        }

        static inline bool renameFile(const char *src, const char *dst)
        {
            if (!src || !dst) return false;
#ifdef _WIN32
            return MoveFileExA(src, dst, MOVEFILE_REPLACE_EXISTING) != 0;
#else
            return rename(src, dst) == 0;
#endif
        }

        static inline bool moveFile(const char *src, const char *dst)
        {
            return File::renameFile(src, dst);
        }

        static inline bool createEmpty(const char *path)
        {
            if (!path) return false;
            File f = File::openFile(path, std::FileMode::Write);
            if (!f.__isOpen) return false;
            defer { f.closeFile(); }
            return true;
        }

        static inline bool touchFile(const char *path)
        {
            if (!path) return false;
            if (File::exists(path)) return true;
            return File::createEmpty(path);
        }

        static inline bool isFile(const char *path)
        {
            return File::exists(path);
        }

        static inline bool isDirectory(const char *path)
        {
            if (!path) return false;
#ifdef _WIN32
            DWORD attrib = GetFileAttributesA(path);
            return (attrib != INVALID_FILE_ATTRIBUTES && (attrib & FILE_ATTRIBUTE_DIRECTORY));
#else
            struct stat st;
            if (stat(path, &st) == 0)
            {
                return S_ISDIR(st.st_mode);
            }
            return false;
#endif
        }

        static inline std::size_t fileSize(const char *path)
        {
            if (!path) return 0;
#ifdef _WIN32
            WIN32_FILE_ATTRIBUTE_DATA data;
            if (GetFileAttributesExA(path, GetFileExInfoStandard, &data))
            {
                return static_cast<std::size_t>(data.nFileSizeLow);
            }
            return 0;
#else
            struct stat st;
            if (stat(path, &st) == 0)
            {
                return static_cast<std::size_t>(st.st_size);
            }
            return 0;
#endif
        }

        static inline bool setReadOnly(const char *path)
        {
            if (!path) return false;
#ifdef _WIN32
            DWORD attr = GetFileAttributesA(path);
            if (attr == INVALID_FILE_ATTRIBUTES) return false;
            return SetFileAttributesA(path, attr | FILE_ATTRIBUTE_READONLY) != 0;
#else
            return chmod(path, 0444) == 0;
#endif
        }

        static inline bool setWritable(const char *path)
        {
            if (!path) return false;
#ifdef _WIN32
            DWORD attr = GetFileAttributesA(path);
            if (attr == INVALID_FILE_ATTRIBUTES) return false;
            return SetFileAttributesA(path, attr & ~FILE_ATTRIBUTE_READONLY) != 0;
#else
            return chmod(path, 0644) == 0;
#endif
        }

        static inline std::String temporaryDirectory()
        {
            std::String out = std::String::new();
#ifdef _WIN32
            char buf[MAX_PATH];
            DWORD res = GetTempPathA(MAX_PATH, buf);
            if (res > 0)
            {
                if (buf[res - 1] == '\\') buf[res - 1] = '\0';
                out.appendChars(buf);
                return out;
            }
            out.appendChars("C:\\Windows\\Temp");
#else
            const char *tmp = getenv("TMPDIR");
            if (!tmp) tmp = "/tmp";
            out.appendChars(tmp);
#endif
            return out;
        }

        static inline std::String temporaryFilename()
        {
            std::String dir = File::temporaryDirectory();
            defer { dir.destroy(); }
            
            if (!dir.__data) return std::String::new();

            char uniqueBuf[64];
            static unsigned int counter = 1000;
            counter++;

            std::size_t c = counter;
            std::size_t pos = 0;
            uniqueBuf[pos++] = 't';
            uniqueBuf[pos++] = 'm';
            uniqueBuf[pos++] = 'p';
            uniqueBuf[pos++] = '_';

            char digits[16];
            std::size_t dLen = 0;
            while (c > 0)
            {
                digits[dLen++] = '0' + (c % 10);
                c /= 10;
            }
            for (std::size_t i = 0; i < dLen; i++)
            {
                uniqueBuf[pos++] = digits[dLen - 1 - i];
            }
            uniqueBuf[pos++] = '.';
            uniqueBuf[pos++] = 't';
            uniqueBuf[pos++] = 'm';
            uniqueBuf[pos++] = 'p';
            uniqueBuf[pos] = '\0';

            std::String out = std::String::new();
            out.appendChars(dir.__data);
#ifdef _WIN32
            out.appendChars("\\");
#else
            out.appendChars("/");
#endif
            out.appendChars(uniqueBuf);

            return out;
        }

        static inline File temporary()
        {
            std::String tmpPath = File::temporaryFilename();
            defer { tmpPath.destroy(); }
            
            if (!tmpPath.__data) return File::empty();
            
            File f = File::openFile(tmpPath.__data, std::FileMode::Write);
            f.removeOnClose();

            return f;
        }

static inline bool createSymlink(const char *target, const char *link)
        {
            if (!target || !link) return false;
#ifdef _WIN32
            typedef BOOLEAN (WINAPI *CreateSymbolicLinkA_t)(LPCSTR, LPCSTR, DWORD);
            HMODULE hMod = GetModuleHandleA("kernel32.dll");
            if (!hMod) return false;
            CreateSymbolicLinkA_t pCreateSymbolicLinkA = (CreateSymbolicLinkA_t)GetProcAddress(hMod, "CreateSymbolicLinkA");
            if (!pCreateSymbolicLinkA) return false;

            DWORD flags = File::isDirectory(target) ? 1 : 0;
            return pCreateSymbolicLinkA(link, target, flags) != 0;
#else
            return symlink(target, link) == 0;
#endif
        }

        static inline bool createHardLink(const char *target, const char *link)
        {
            if (!target || !link) return false;
#ifdef _WIN32
            typedef BOOL (WINAPI *CreateHardLinkA_t)(LPCSTR, LPCSTR, LPSECURITY_ATTRIBUTES);
            HMODULE hMod = GetModuleHandleA("kernel32.dll");
            if (!hMod) return false;
            CreateHardLinkA_t pCreateHardLinkA = (CreateHardLinkA_t)GetProcAddress(hMod, "CreateHardLinkA");
            if (!pCreateHardLinkA) return false;

            return pCreateHardLinkA(link, target, nullptr) != 0;
#else
            return link(target, link) == 0;
#endif
        }

        static inline bool isSymlink(const char *path)
        {
            if (!path) return false;
#ifdef _WIN32
            DWORD attr = GetFileAttributesA(path);
            return (attr != INVALID_FILE_ATTRIBUTES && (attr & FILE_ATTRIBUTE_REPARSE_POINT));
#else
            struct stat st;
            if (lstat(path, &st) == 0)
            {
                return S_ISLNK(st.st_mode);
            }
            return false;
#endif
        }

        static inline std::String readSymlink(const char *path)
        {
            if (!path) return std::String::new();
#ifdef _WIN32
            return std::String::new();
#else
            char buf[1024];
            std::ssize_t len = readlink(path, buf, sizeof(buf) - 1);
            if (len != -1)
            {
                buf[len] = '\0';
                std::String out = std::String::new();
                out.appendChars(buf);
                return out;
            }
            return std::String::new();
#endif
        }
    };

    struct DirectoryIterator
    {
#ifdef _WIN32
        void* __findHandle;
        WIN32_FIND_DATAA __findData;
        char  __basePath[1024];
        bool  __isFirst;
#else
        DIR*  __dirHandle;
        char  __basePath[1024];
#endif
        bool  __validT;

        static inline DirectoryIterator open(const char *path)
        {
            DirectoryIterator it;
            it.__validT = false;
            if (!path) return it;

            std::size_t len = std::stringLength(path);
            if (len >= sizeof(it.__basePath) - 3) return it;

            for (std::size_t i = 0; i <= len; i++)
                it.__basePath[i] = path[i];

#ifdef _WIN32
            it.__isFirst = true;
            char searchPattern[1024];
            std::size_t pLen = len;
            for (std::size_t i = 0; i < pLen; i++)
                searchPattern[i] = path[i];

            if (pLen > 0 && searchPattern[pLen - 1] != '\\' && searchPattern[pLen - 1] != '/')
            {
                searchPattern[pLen++] = '\\';
            }
            searchPattern[pLen++] = '*';
            searchPattern[pLen] = '\0';

            it.__findHandle = FindFirstFileA(searchPattern, &it.__findData);
            if (it.__findHandle != INVALID_HANDLE_VALUE)
            {
                it.__validT = true;
            }
#else
            it.__dirHandle = opendir(path);
            if (it.__dirHandle)
            {
                it.__validT = true;
            }
#endif
            return it;
        }

        inline bool next(DirectoryIterator *self, DirectoryEntry *entry)
        {
            if (!self->__validT || !entry) return false;

#ifdef _WIN32
            while (true)
            {
                if (!self->__isFirst)
                {
                    if (!FindNextFileA(self->__findHandle, &self->__findData))
                    {
                        self->__validT = false;
                        return false;
                    }
                }
                self->__isFirst = false;

                const char *name = self->__findData.cFileName;
                if (name[0] == '.' && (name[1] == '\0' || (name[1] == '.' && name[2] == '\0')))
                {
                    continue;
                }

                entry->name = std::String::new();
                entry->name.appendChars(name);

                entry->fullPath = std::String::new();
                entry->fullPath.appendChars(self->__basePath);
                entry->fullPath.appendChars("\\");
                entry->fullPath.appendChars(name);

                entry->isDirectory = (self->__findData.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0;
                entry->isFile = !entry->isDirectory;
                entry->size = static_cast<std::size_t>(self->__findData.nFileSizeLow);

                return true;
            }
#else
            struct dirent *dp = nullptr;
            while ((dp = readdir(self->__dirHandle)) != nullptr)
            {
                const char *name = dp->d_name;
                if (name[0] == '.' && (name[1] == '\0' || (name[1] == '.' && name[2] == '\0')))
                {
                    continue;
                }

                entry->name = std::String::new();
                entry->name.appendChars(name);

                entry->fullPath = std::String::new();
                entry->fullPath.appendChars(self->__basePath);
                entry->fullPath.appendChars("/");
                entry->fullPath.appendChars(name);

                entry->isDirectory = std::File::isDirectory(entry->fullPath.__data);
                entry->isFile = std::File::isFile(entry->fullPath.__data);
                entry->size = std::File::fileSize(entry->fullPath.__data);

                return true;
            }
            self->__validT = false;
            return false;
#endif
        }

        inline void close(DirectoryIterator *self)
        {
            if (!self->__validT) return;
#ifdef _WIN32
            FindClose(self->__findHandle);
            self->__findHandle = INVALID_HANDLE_VALUE;
#else
            closedir(self->__dirHandle);
            self->__dirHandle = nullptr;
#endif
            self->__validT = false;
        }
    };

    namespace Directory
    {
        static bool create(const char *path)
        {
            if (!path) return false;
#ifdef _WIN32
            return CreateDirectoryA(path, nullptr) != 0;
#else
            return mkdir(path, 0755) == 0;
#endif
        }

        static bool exists(const char *path)
        {
            return std::File::isDirectory(path);
        }

        static bool createRecursive(const char *path)
        {
            if (!path) return false;
            if (std::Directory::exists(path)) return true;

            char buf[1024];
            std::size_t len = std::stringLength(path);
            if (len >= sizeof(buf)) return false;

            for (std::size_t i = 0; i <= len; i++)
                buf[i] = path[i];

            for (std::size_t i = 0; i < len; i++)
            {
                if (buf[i] == '/' || buf[i] == '\\')
                {
                    if (i == 0) continue;
                    char tmp = buf[i];
                    buf[i] = '\0';
                    if (!std::Directory::exists(buf))
                    {
                        std::Directory::create(buf);
                    }
                    buf[i] = tmp;
                }
            }
            return std::Directory::create(buf);
        }

        static bool remove(const char *path)
        {
            if (!path) return false;
#ifdef _WIN32
            return RemoveDirectoryA(path) != 0;
#else
            return rmdir(path) == 0;
#endif
        }

        static void listRecursiveHelper(const char *path, DirectoryEntry **entries, std::size_t *len, std::size_t *capacity)
        {
            std::DirectoryIterator it = std::DirectoryIterator::open(path);
            defer { it.close(); }
            
            DirectoryEntry entry;
            while (it.next(&entry))
            {
                if (*len >= *capacity)
                {
                    *capacity *= 2;
                    DirectoryEntry *newEntries = static_cast<DirectoryEntry*>(std::reallocateMemory(*entries, sizeof(DirectoryEntry) * (*capacity)));
                    if (!newEntries) break;
                    *entries = newEntries;
                }

                char full[1024];
                std::size_t fpLen = std::stringLength(entry.fullPath.__data);
                for (std::size_t i = 0; i <= fpLen && i < 1023; i++)
                    full[i] = entry.fullPath.__data[i];

                bool isDir = entry.isDirectory;
                (*entries)[(*len)++] = entry;

                if (isDir)
                {
                    std::Directory::listRecursiveHelper(full, entries, len, capacity);
                }
            }
        }

        static bool removeRecursive(const char *path)
        {
            if (!path || !std::Directory::exists(path)) return false;

            std::DirectoryIterator it = std::DirectoryIterator::open(path);
            defer { it.close(); }
            
            DirectoryEntry entry;
            while (it.next(&entry))
            {
                defer { entry.destroy(); }
                if (entry.isDirectory)
                {
                    std::Directory::removeRecursive(entry.fullPath.__data);
                }
                else
                {
                    std::File::remove(entry.fullPath.__data);
                }
            }

            return std::Directory::remove(path);
        }

        static bool isEmpty(const char *path)
        {
            if (!std::Directory::exists(path)) return false;
            std::DirectoryIterator it = std::DirectoryIterator::open(path);
            defer { it.close(); }
            
            DirectoryEntry entry;
            bool hasItem = it.next(&entry);
            if (hasItem)
            {
                entry.destroy();
            }
            return !hasItem;
        }

        static std::String current()
        {
            std::String out = std::String::new();
#ifdef _WIN32
            char buf[MAX_PATH];
            DWORD res = GetCurrentDirectoryA(MAX_PATH, buf);
            if (res > 0)
            {
                out.appendChars(buf);
            }
#else
            char buf[1024];
            if (getcwd(buf, sizeof(buf)))
            {
                out.appendChars(buf);
            }
#endif
            return out;
        }

        static bool setCurrent(const char *path)
        {
            if (!path) return false;
#ifdef _WIN32
            return SetCurrentDirectoryA(path) != 0;
#else
            return chdir(path) == 0;
#endif
        }

        static std::String executableDirectory()
        {
            std::String out = std::String::new();
#ifdef _WIN32
            char buf[MAX_PATH];
            DWORD len = GetModuleFileNameA(nullptr, buf, MAX_PATH);
            if (len > 0)
            {
                for (std::size_t i = len; i > 0; i--)
                {
                    if (buf[i - 1] == '\\' || buf[i - 1] == '/')
                    {
                        buf[i - 1] = '\0';
                        break;
                    }
                }
                out.appendChars(buf);
            }
#else
            char buf[1024];
            std::ssize_t len = readlink("/proc/self/exe", buf, sizeof(buf) - 1);
            if (len != -1)
            {
                buf[len] = '\0';
                for (std::size_t i = len; i > 0; i--)
                {
                    if (buf[i - 1] == '/')
                    {
                        buf[i - 1] = '\0';
                        break;
                    }
                }
                out.appendChars(buf);
            }
#endif
            return out;
        }

        static std::String temporaryDirectory()
        {
            return std::File::temporaryDirectory();
        }

        static std::String homeDirectory()
        {
            std::String out = std::String::new();
#ifdef _WIN32
            const char *home = getenv("USERPROFILE");
            if (home) out.appendChars(home);
#else
            const char *home = getenv("HOME");
            if (home) out.appendChars(home);
#endif
            return out;
        }

        static DirectoryEntry *list(const char *path, std::size_t *count)
        {
            if (count) *count = 0;
            if (!path || !std::Directory::exists(path)) return nullptr;

            std::size_t capacity = 16;
            std::size_t len = 0;
            DirectoryEntry *entries = static_cast<DirectoryEntry*>(std::allocateMemory(sizeof(DirectoryEntry) * capacity));
            if (!entries) return nullptr;

            std::DirectoryIterator it = std::DirectoryIterator::open(path);
            defer { it.close(); }
            
            DirectoryEntry entry;
            while (it.next(&entry))
            {
                if (len >= capacity)
                {
                    capacity *= 2;
                    DirectoryEntry *newEntries = static_cast<DirectoryEntry*>(std::reallocateMemory(entries, sizeof(DirectoryEntry) * capacity));
                    if (!newEntries) break;
                    entries = newEntries;
                }
                entries[len++] = entry;
            }

            if (count) *count = len;
            return entries;
        }

        static DirectoryEntry *listRecursive(const char *path, std::size_t *count)
        {
            if (count) *count = 0;
            if (!path || !std::Directory::exists(path)) return nullptr;

            std::size_t capacity = 32;
            std::size_t len = 0;
            DirectoryEntry *entries = static_cast<DirectoryEntry*>(std::allocateMemory(sizeof(DirectoryEntry) * capacity));
            if (!entries) return nullptr;

            std::Directory::listRecursiveHelper(path, &entries, &len, &capacity);

            if (count) *count = len;
            return entries;
        }

        static std::DirectoryIterator walk(const char *path)
        {
            return std::DirectoryIterator::open(path);
        }
    }

    namespace Path
    {
        static std::String join(const char *p1, const char *p2)
        {
            std::String out = std::String::new();
            if (!p1 && !p2) return out;
            if (!p1) { out.appendChars(p2); return out; }
            if (!p2) { out.appendChars(p1); return out; }

            out.appendChars(p1);
            std::size_t len1 = std::stringLength(p1);
            if (len1 > 0 && p1[len1 - 1] != '/' && p1[len1 - 1] != '\\')
            {
#ifdef _WIN32
                out.appendChars("\\");
#else
                out.appendChars("/");
#endif
            }
            if (p2[0] == '/' || p2[0] == '\\')
            {
                out.appendChars(p2 + 1);
            }
            else
            {
                out.appendChars(p2);
            }
            return out;
        }

        static std::String normalize(const char *path)
        {
            std::String out = std::String::new();
            if (!path) return out;

            std::size_t len = std::stringLength(path);
            char *buf = static_cast<char*>(std::allocateMemory(len + 1));
            if (!buf) return out;
            defer { std::freeMemory(buf); }

            std::size_t bLen = 0;
            for (std::size_t i = 0; i < len; i++)
            {
                char c = path[i];
#ifdef _WIN32
                if (c == '/') c = '\\';
#else
                if (c == '\\') c = '/';
#endif
                if (bLen > 0 && (c == '/' || c == '\\') && (buf[bLen - 1] == '/' || buf[bLen - 1] == '\\'))
                {
                    continue;
                }
                buf[bLen++] = c;
            }
            buf[bLen] = '\0';

            out.appendChars(buf);
            return out;
        }

        static std::String filename(const char *path)
        {
            std::String out = std::String::new();
            if (!path) return out;

            std::size_t len = std::stringLength(path);
            std::size_t lastIdx = len;

            for (std::size_t i = len; i > 0; i--)
            {
                if (path[i - 1] == '/' || path[i - 1] == '\\')
                {
                    lastIdx = i;
                    break;
                }
            }

            if (lastIdx < len)
            {
                out.appendChars(path + lastIdx);
            }
            else
            {
                out.appendChars(path);
            }
            return out;
        }

        static std::String stem(const char *path)
        {
            std::String fname = std::Path::filename(path);
            if (!fname.__data) return std::String::new();

            std::size_t len = fname.__len;
            std::size_t dotIdx = len;

            for (std::size_t i = len; i > 0; i--)
            {
                if (fname.__data[i - 1] == '.')
                {
                    dotIdx = i - 1;
                    break;
                }
            }

            if (dotIdx < len && dotIdx > 0)
            {
                fname.__data[dotIdx] = '\0';
                fname.__len = dotIdx;
            }
            return fname;
        }

        static std::String extension(const char *path)
        {
            std::String fname = std::Path::filename(path);
            defer { fname.destroy(); }
            
            std::String out = std::String::new();
            if (!fname.__data) return out;

            std::size_t len = fname.__len;
            for (std::size_t i = len; i > 0; i--)
            {
                if (fname.__data[i - 1] == '.')
                {
                    out.appendChars(fname.__data + (i - 1));
                    break;
                }
            }
            return out;
        }

        static std::String parent(const char *path)
        {
            std::String out = std::String::new();
            if (!path) return out;

            std::size_t len = std::stringLength(path);
            std::size_t lastIdx = 0;
            bool found = false;

            for (std::size_t i = len; i > 0; i--)
            {
                if (path[i - 1] == '/' || path[i - 1] == '\\')
                {
                    lastIdx = i - 1;
                    found = true;
                    break;
                }
            }

            if (found)
            {
                char *buf = static_cast<char*>(std::allocateMemory(lastIdx + 1));
                if (buf)
                {
                    defer { std::freeMemory(buf); }
                    for (std::size_t i = 0; i < lastIdx; i++)
                        buf[i] = path[i];
                    buf[lastIdx] = '\0';
                    out.appendChars(buf);
                }
            }
            return out;
        }

        static bool hasExtension(const char *path, const char *ext)
        {
            if (!path || !ext) return false;
            std::String fileExt = std::Path::extension(path);
            defer { fileExt.destroy(); }
            
            if (!fileExt.__data) return false;

            std::size_t len1 = fileExt.__len;
            std::size_t len2 = std::stringLength(ext);
            bool match = false;

            if (ext[0] == '.' && len1 == len2)
            {
                match = true;
                for (std::size_t i = 0; i < len1; i++)
                {
                    if (fileExt.__data[i] != ext[i]) { match = false; break; }
                }
            }
            else if (ext[0] != '.' && len1 == len2 + 1)
            {
                match = true;
                for (std::size_t i = 0; i < len2; i++)
                {
                    if (fileExt.__data[i + 1] != ext[i]) { match = false; break; }
                }
            }

            return match;
        }

        static bool isAbsolute(const char *path)
        {
            if (!path) return false;
#ifdef _WIN32
            if ((path[0] >= 'A' && path[0] <= 'Z') || (path[0] >= 'a' && path[0] <= 'z'))
            {
                if (path[1] == ':') return true;
            }
            return (path[0] == '\\' && path[1] == '\\');
#else
            return path[0] == '/';
#endif
        }

        static bool isRelative(const char *path)
        {
            return !std::Path::isAbsolute(path);
        }

        static std::String absolute(const char *path)
        {
            if (!path) return std::String::new();
            if (std::Path::isAbsolute(path))
            {
                std::String out = std::String::new();
                out.appendChars(path);
                return out;
            }

            std::String cur = std::Directory::current();
            defer { cur.destroy(); }
            
            std::String out = std::Path::join(cur.__data, path);
            return std::Path::normalize(out.__data);
        }

        static std::String relative(const char *from, const char *to)
        {
            std::String out = std::String::new();
            if (!from || !to) return out;

            std::String absFrom = std::Path::absolute(from);
            defer { absFrom.destroy(); }
            
            std::String absTo = std::Path::absolute(to);
            defer { absTo.destroy(); }

            std::size_t idx = 0;
            while (idx < absFrom.__len && idx < absTo.__len && absFrom.__data[idx] == absTo.__data[idx])
            {
                idx++;
            }

            if (idx < absTo.__len)
            {
                out.appendChars(absTo.__data + idx);
            }

            return out;
        }
    }

    struct FileInfo
    {
        std::String path;
        std::size_t size;
        bool exists;
        bool isDirectory;
        bool isFile;
        bool readOnly;
        bool hidden;
        std::uint64_t creationTime;
        std::uint64_t lastWriteTime;
        std::uint64_t lastAccessTime;

        inline void destroy(FileInfo *self)
        {
            if (!self) return;
            self->path.destroy();
        }

        static inline FileInfo info(const char *path)
        {
            FileInfo fi = FileInfo {
                path: std::String::new(),
                size: 0,
                exists: false,
                isDirectory: false,
                isFile: false,
                readOnly: false,
                hidden: false,
                creationTime: 0,
                lastWriteTime: 0,
                lastAccessTime: 0
            };

            if (!path) return fi;
            fi.path.appendChars(path);

#ifdef _WIN32
            WIN32_FILE_ATTRIBUTE_DATA data;
            if (GetFileAttributesExA(path, GetFileExInfoStandard, &data))
            {
                fi.exists = true;
                fi.isDirectory = (data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0;
                fi.isFile = !fi.isDirectory;
                fi.readOnly = (data.dwFileAttributes & FILE_ATTRIBUTE_READONLY) != 0;
                fi.hidden = (data.dwFileAttributes & FILE_ATTRIBUTE_HIDDEN) != 0;
                fi.size = static_cast<std::size_t>(data.nFileSizeLow);

                fi.creationTime = (static_cast<std::uint64_t>(data.ftCreationTime.dwHighDateTime) << 32) | data.ftCreationTime.dwLowDateTime;
                fi.lastWriteTime = (static_cast<std::uint64_t>(data.ftLastWriteTime.dwHighDateTime) << 32) | data.ftLastWriteTime.dwLowDateTime;
                fi.lastAccessTime = (static_cast<std::uint64_t>(data.ftLastAccessTime.dwHighDateTime) << 32) | data.ftLastAccessTime.dwLowDateTime;
            }
#else
            struct stat st;
            if (lstat(path, &st) == 0)
            {
                fi.exists = true;
                fi.isDirectory = S_ISDIR(st.st_mode);
                fi.isFile = S_ISREG(st.st_mode);
                fi.readOnly = (access(path, W_OK) != 0);
                fi.hidden = (path[0] == '.');
                fi.size = static_cast<std::size_t>(st.st_size);

                fi.creationTime = static_cast<std::uint64_t>(st.st_ctime);
                fi.lastWriteTime = static_cast<std::uint64_t>(st.st_mtime);
                fi.lastAccessTime = static_cast<std::uint64_t>(st.st_atime);
            }
#endif
            return fi;
        }
    };

    inline std::String readText(const char *path)
    {
        if (!path) return std::String::new();
        File f = std::File::openFile(path, std::FileMode::Read);
        if (!f.__isOpen) return std::String::new();
        defer { f.closeFile(); }
        
        return f.readAll();
    }

    inline bool writeText(const char *path, const char *text)
    {
        return std::File::writeAll(path, text);
    }

    inline std::String* splitLines(const char *path, std::size_t *count)
    {
        if (count) *count = 0;
        if (!path) return nullptr;

        std::String content = std::readText(path);
        defer { content.destroy(); }
        
        if (!content.__data) return nullptr;

        std::size_t capacity = 16;
        std::size_t lineCount = 0;
        std::String *lines = static_cast<std::String*>(std::allocateMemory(sizeof(std::String) * capacity));
        if (!lines) return nullptr;

        char *curr = content.__data;
        char *start = curr;

        while (*curr != '\0')
        {
            if (*curr == '\n' || (*curr == '\r' && *(curr + 1) == '\n'))
            {
                std::size_t len = static_cast<std::size_t>(curr - start);
                char *buf = static_cast<char*>(std::allocateMemory(len + 1));
                if (buf)
                {
                    for (std::size_t i = 0; i < len; i++) buf[i] = start[i];
                    buf[len] = '\0';

                    if (lineCount >= capacity)
                    {
                        capacity *= 2;
                        std::String *newLines = static_cast<std::String*>(std::reallocateMemory(lines, sizeof(std::String) * capacity));
                        if (newLines) lines = newLines;
                    }

                    lines[lineCount] = std::String::new();
                    lines[lineCount].appendChars(buf);
                    std::freeMemory(buf);
                    lineCount++;
                }

                if (*curr == '\r' && *(curr + 1) == '\n') curr++;
                start = curr + 1;
            }
            curr++;
        }

        if (start < curr)
        {
            std::size_t len = static_cast<std::size_t>(curr - start);
            char *buf = static_cast<char*>(std::allocateMemory(len + 1));
            if (buf)
            {
                for (std::size_t i = 0; i < len; i++) buf[i] = start[i];
                buf[len] = '\0';

                if (lineCount >= capacity)
                {
                    capacity *= 2;
                    std::String *newLines = static_cast<std::String*>(std::reallocateMemory(lines, sizeof(std::String) * capacity));
                    if (newLines) lines = newLines;
                }

                lines[lineCount] = std::String::new();
                lines[lineCount].appendChars(buf);
                std::freeMemory(buf);
                lineCount++;
            }
        }

        if (count) *count = lineCount;
        return lines;
    }

    inline bool appendLine(const char *path, const char *text)
    {
        if (!path || !text) return false;
        std::String line = std::String::new();
        defer { line.destroy(); }
        
        line.appendChars(text);
        line.appendChars("\n");
        return std::File::appendFile(path, line.__data);
    }

} // namespace std

#endif // #ifndef _FS_HP