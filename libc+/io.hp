// io.hp

// superset of _io.hp that introduces std::String returning functions

#ifndef _IO_HP
#define _IO_HP
#include <string>
#include <types>
#include <internal/_io>
#include <internal/_asyncin.hp>
#include <memory>

namespace std
{
    std::String readString()
    {
        char *tmp = std::readDynamic();

        std::String result = std::String::fromChars(tmp);

        std::freeMemory(tmp);

        return result;
    }

    std::String promptString(const char *const _chp)
    {
        if (_chp)
            std::puts(_chp);
        return std::readString();
    }

    void printString(std::String _str)
    {
        std::puts(_str.chars());
    }
}

#endif // #ifndef _IO_HP