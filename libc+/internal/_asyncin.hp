// _asyncin.hp

// for non-blocking input using native Win32 console input records

#ifndef __ASYNCIN_HP
#define __ASYNCIN_HP

#include <types>
#include <internal/_utilities>

#ifdef _WIN32
#include <windows.h>
#else
#include <unistd.h>
#include <fcntl.h>
#include <termios.h>
#endif

namespace HIDDEN__ASYNCIN
{
    inline bool *get_initialized_flag()
    {
        static bool initialized = false;
        return &initialized;
    }

    struct KeyQueue
    {
        char buffer[2];
        int count;
        int head;
        int tail;
    };

    inline KeyQueue *get_key_queue()
    {
        static KeyQueue kq = { { '\0', '\0' }, 0, 0, 0 };
        return &kq;
    }

#ifndef _WIN32
    inline struct termios *get_original_termios()
    {
        static struct termios orig_termios;
        return &orig_termios;
    }

    inline void restore_terminal()
    {
        if (*HIDDEN__ASYNCIN::get_initialized_flag())
        {
            tcsetattr(STDIN_FILENO, TCSAFLUSH, HIDDEN__ASYNCIN::get_original_termios());
            *HIDDEN__ASYNCIN::get_initialized_flag() = false;
        }
    }
#else
    inline DWORD *get_original_console_mode()
    {
        static DWORD orig_mode = 0;
        return &orig_mode;
    }

    inline void restore_terminal()
    {
        if (*HIDDEN__ASYNCIN::get_initialized_flag())
        {
            HANDLE hStdin = GetStdHandle(STD_INPUT_HANDLE);
            SetConsoleMode(hStdin, *HIDDEN__ASYNCIN::get_original_console_mode());
            *HIDDEN__ASYNCIN::get_initialized_flag() = false;
        }
    }
#endif
} // namespace HIDDEN__ASYNCIN

namespace std
{
    inline void initAsyncInput()
    {
        if (*HIDDEN__ASYNCIN::get_initialized_flag())
            return;

#ifdef _WIN32
        HANDLE hStdin = GetStdHandle(STD_INPUT_HANDLE);
        DWORD mode = 0;
        if (GetConsoleMode(hStdin, &mode))
        {
            *HIDDEN__ASYNCIN::get_original_console_mode() = mode;
            // Keep ENABLE_PROCESSED_INPUT so Ctrl+C works properly as an interrupt
            mode = (mode & ~ENABLE_LINE_INPUT & ~ENABLE_ECHO_INPUT) | ENABLE_PROCESSED_INPUT;
            SetConsoleMode(hStdin, mode);
            *HIDDEN__ASYNCIN::get_initialized_flag() = true;
        }
#else
        struct termios term;
        if (tcgetattr(STDIN_FILENO, &term) == 0)
        {
            *HIDDEN__ASYNCIN::get_original_termios() = term;
            term.c_lflag &= ~(ICANON | ECHO);
            term.c_cc[VMIN] = 0;
            term.c_cc[VTIME] = 0;

            if (tcsetattr(STDIN_FILENO, TCSAFLUSH, &term) == 0)
            {
                *HIDDEN__ASYNCIN::get_initialized_flag() = true;
            }
        }
#endif
    }

    inline void cleanupAsyncInput()
    {
        HIDDEN__ASYNCIN::restore_terminal();
    }

    inline bool hasInputAsync()
    {
        std::initAsyncInput();
        
        HIDDEN__ASYNCIN::KeyQueue *kq = HIDDEN__ASYNCIN::get_key_queue();
        if (kq->count > 0) return true;

#ifdef _WIN32
        HANDLE hStdin = GetStdHandle(STD_INPUT_HANDLE);
        DWORD events = 0;
        if (GetNumberOfConsoleInputEvents(hStdin, &events) && events > 0)
        {
            return true;
        }
        return false;
#else
        fd_set readfds;
        struct timeval tv;
        
        FD_ZERO(&readfds);
        FD_SET(STDIN_FILENO, &readfds);
        
        tv.tv_sec = 0;
        tv.tv_usec = 0;
        
        int retval = select(STDIN_FILENO + 1, &readfds, nullptr, nullptr, &tv);
        return (retval > 0 && FD_ISSET(STDIN_FILENO, &readfds));
#endif
    }

    inline bool getcAsync(char *const _chChar)
    {
        if (!_chChar) return false;
        std::initAsyncInput();

        HIDDEN__ASYNCIN::KeyQueue *kq = HIDDEN__ASYNCIN::get_key_queue();

#ifdef _WIN32
        HANDLE hStdin = GetStdHandle(STD_INPUT_HANDLE);
        INPUT_RECORD inputRecords[128];
        DWORD numEventsRead = 0;
        DWORD numEvents = 0;

        if (GetNumberOfConsoleInputEvents(hStdin, &numEvents) && numEvents > 0)
        {
            if (PeekConsoleInput(hStdin, inputRecords, 128, &numEventsRead) && numEventsRead > 0)
            {
                // Actually consume them
                ReadConsoleInput(hStdin, inputRecords, numEventsRead, &numEventsRead);

                for (DWORD i = 0; i < numEventsRead; i++)
                {
                    if (inputRecords[i].EventType == KEY_EVENT && inputRecords[i].Event.KeyEvent.bKeyDown)
                    {
                        char asciiChar = inputRecords[i].Event.KeyEvent.uChar.AsciiChar;
                        if (asciiChar != '\0')
                        {
                            if (kq->count < 2)
                            {
                                kq->buffer[kq->tail] = asciiChar;
                                kq->tail = (kq->tail + 1) % 2;
                                kq->count++;
                            }
                            else
                            {
                                kq->buffer[kq->tail] = asciiChar;
                                kq->tail = (kq->tail + 1) % 2;
                                kq->head = (kq->head + 1) % 2;
                            }
                        }
                    }
                }
            }
        }
#else
        char temp_c = '\0';
        std::ssize_t read_bytes = 0;

        while ((read_bytes = read(STDIN_FILENO, &temp_c, 1)) > 0)
        {
            if (kq->count < 2)
            {
                kq->buffer[kq->tail] = temp_c;
                kq->tail = (kq->tail + 1) % 2;
                kq->count++;
            }
            else
            {
                kq->buffer[kq->tail] = temp_c;
                kq->tail = (kq->tail + 1) % 2;
                kq->head = (kq->head + 1) % 2;
            }
        }
        tcflush(STDIN_FILENO, TCIFLUSH);
#endif

        if (kq->count > 0)
        {
            *_chChar = kq->buffer[kq->head];
            kq->head = (kq->head + 1) % 2;
            kq->count--;
            return true;
        }

        return false;
    }

} // namespace std

#endif // #ifndef __ASYNCIN_HP