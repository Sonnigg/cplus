// _bscstrlen.hp


#ifndef __UTILITIES_HP
#define __UTILITIES_HP

#include <types>

namespace std
{
/*

    HELPERS

*/

    std::size_t _chpLength(const char *const _chpString)
    {
        std::size_t total = 0;
        for (;_chpString[total];total++){}
        return total;
    } // std::size_t std::_chpLength(const char *const _chpString)

    std::size_t _chpLengthPadding(const char *const _chpString)
    {
        std::size_t total = 0;
        for (;_chpString[total];total++){}
        return total+1;
    } // std::size_t std::_chpLengthPadding(const char *const _chpString)
} // namespace std

#endif // #ifndef __UTILITIES_HP