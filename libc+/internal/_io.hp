// _io.hp

// IO stub for non-String behaviour functions

#ifndef __IO_HP
#define __IO_HP

#include <types>
#include <internal/_utilities>
#include <memory>

#ifdef _WIN32
#include <windows.h>
#else
#include <unistd.h>
#endif

namespace HIDDEN__STD__IO
{
    const std::size_t IO_BUFFER_SIZE = 8192; // 4096 * 2

    struct BufferedStream
    {
        char        buffer[8192];
        std::size_t head;
        std::size_t tail;
        bool        eof;
    };

    // Exit control flag management for Ctrl + C tracking
    inline bool *get_exit_flag()
    {
        static bool exit_flag = false;
        return &exit_flag;
    }

    // Platform-native exit helper
    inline void system_exit(int code)
    {
#ifdef _WIN32
        ExitProcess(static_cast<UINT>(code));
#else
        _exit(code);
#endif
    }

    inline void check_exit()
    {
        if (*HIDDEN__STD__IO::get_exit_flag())
        {
            HIDDEN__STD__IO::system_exit(-1);
        }
    }

    inline void trigger_exit()
    {
        *HIDDEN__STD__IO::get_exit_flag() = true;
        HIDDEN__STD__IO::system_exit(-1);
    }

    inline bool flush_buffered_writer(int fd, BufferedStream *state)
    {
        HIDDEN__STD__IO::check_exit();
        if (!state->tail) { // meaning state->tail == 0
            return true;
        }

        std::size_t total_written = 0;
        while (total_written < state->tail)
        {
#ifdef _WIN32
            DWORD written = 0;
            HANDLE h = GetStdHandle(fd == 1 ? STD_OUTPUT_HANDLE : STD_ERROR_HANDLE);
            if (!WriteFile(h, state->buffer + total_written, static_cast<DWORD>(state->tail - total_written), &written, nullptr) || written == 0)
            {
                state->tail = 0;
                return false;
            }
            total_written += written;
#else
            std::ssize_t written = write(fd, state->buffer + total_written, state->tail - total_written);
            if (written <= 0)
            {
                state->tail = 0;
                return false;
            }
            total_written += static_cast<std::size_t>(written);
#endif
        }
        state->tail = 0;
        return true;
    }

    inline BufferedStream *get_stdin_state()
    {
        // {0} zero-initializes all fields (buffer, head, tail, eof) 
        // which is a valid compile-time constant expression.
        static BufferedStream _stdin_state = { {0}, 0, 0, false };
        return &_stdin_state;
    }

    inline BufferedStream *get_stdout_state()
    {
        static BufferedStream _stdout_state = { {0}, 0, 0, false };
        return &_stdout_state;
    }

    inline void flush_stdout_internal()
    {
        HIDDEN__STD__IO::check_exit();
        HIDDEN__STD__IO::flush_buffered_writer(1, HIDDEN__STD__IO::get_stdout_state());
    }
} // namespace HIDDEN__STD__IO

namespace std
{

    inline void write_stdout(const char *const _chpString, std::ptrsize_t _pszLength)
    {
        HIDDEN__STD__IO::check_exit();
        if (!_chpString || _pszLength == 0) return;

        // Cache the state pointer once to avoid multiple unsequenced calls
        HIDDEN__STD__IO::BufferedStream* state = HIDDEN__STD__IO::get_stdout_state();
        std::ptrsize_t index = 0;

        while (index < _pszLength)
        {
            std::size_t space_left = 8192 - state->tail;
            std::ptrsize_t chunk = (_pszLength - index < space_left) ? (_pszLength - index) : space_left;

            for (std::ptrsize_t i = 0; i < chunk; i++)
            {
                state->buffer[state->tail++] = _chpString[index + i];
            }

            index += chunk;

            if (state->tail >= 8192)
            {
                HIDDEN__STD__IO::flush_stdout_internal();
            }
        }
    } // void std::write_stdout(const char *const _chpString, std::ptrsize_t _pszLength)

    inline void write_stderr(const char *const _chpString, std::ptrsize_t _pszLength)
    {
        HIDDEN__STD__IO::check_exit();
        if (!_chpString || _pszLength == 0) return;

        std::ptrsize_t total_written = 0;
        while (total_written < _pszLength)
        {
#ifdef _WIN32
            DWORD written = 0;
            WriteFile(
                GetStdHandle(STD_ERROR_HANDLE),
                _chpString + total_written,
                static_cast<DWORD>(_pszLength - total_written),
                &written,
                nullptr
            );
            if (written == 0) break;
            total_written += written;
#else
            std::ssize_t written = write(STDERR_FILENO, _chpString + total_written, _pszLength - total_written);
            if (written <= 0) break;
            total_written += static_cast<std::size_t>(written);
#endif
        }
    } // void std::write_stderr(const char *const _chpString, std::ptrsize_t _pszLength)

    inline void get_stdin(char *const _chpBuffer, std::ptrsize_t _pszLength)
    {
        HIDDEN__STD__IO::check_exit();
        if (!_chpBuffer || _pszLength == 0) return;

        std::ptrsize_t total_read = 0;
        while (total_read < _pszLength)
        {
            if (HIDDEN__STD__IO::get_stdin_state()->head >= HIDDEN__STD__IO::get_stdin_state()->tail)
            {
                HIDDEN__STD__IO::get_stdin_state()->head = 0;
                HIDDEN__STD__IO::get_stdin_state()->tail = 0;

#ifdef _WIN32
                DWORD read_bytes = 0;
                ReadFile(
                    GetStdHandle(STD_INPUT_HANDLE),
                    HIDDEN__STD__IO::get_stdin_state()->buffer,
                    8192,
                    &read_bytes,
                    nullptr
                );
                HIDDEN__STD__IO::get_stdin_state()->tail = static_cast<std::size_t>(read_bytes);
#else
                std::ssize_t read_bytes = read(STDIN_FILENO, HIDDEN__STD__IO::get_stdin_state()->buffer, 8192);
                if (read_bytes > 0)
                {
                    HIDDEN__STD__IO::get_stdin_state()->tail = static_cast<std::size_t>(read_bytes);
                }
#endif
                if (HIDDEN__STD__IO::get_stdin_state()->tail == 0)
                {
                    HIDDEN__STD__IO::get_stdin_state()->eof = true;
                    break;
                }
            }

            std::size_t available = HIDDEN__STD__IO::get_stdin_state()->tail - HIDDEN__STD__IO::get_stdin_state()->head;
            std::ptrsize_t requested = _pszLength - total_read;
            std::size_t to_copy = (requested < available) ? static_cast<std::size_t>(requested) : available;

            for (std::size_t i = 0; i < to_copy; i++)
            {
                char ch = HIDDEN__STD__IO::get_stdin_state()->buffer[HIDDEN__STD__IO::get_stdin_state()->head++];
                if (ch == 3)
                {
                    HIDDEN__STD__IO::trigger_exit();
                }
                _chpBuffer[total_read + i] = ch;
            }

            total_read += to_copy;
        }

        // Zero out any unfilled requested bytes safely if EOF was reached early
        for (std::ptrsize_t i = total_read; i < _pszLength; i++)
        {
            _chpBuffer[i] = '\0';
        }
    } // void std::get_stdin(char *const _chpBuffer, std::ptrsize_t _pszLength)

    /**
     * Reads a single character from stdin safely
     **/
    inline char getc()
    {
        HIDDEN__STD__IO::check_exit();
        char ch = '\0';
        std::get_stdin(&ch, 1);
        return ch;
    } // char std::getc()

    /**
     * Reads a string stream up to a maximum length safely with bounds checking, control sequences, and signal handling (Ctrl+C, Ctrl+D, Ctrl+Z)[cite: 11]
     **/
    inline void gets(char *const _chpBuffer, std::ptrsize_t _pszMaxLength)
    {
        HIDDEN__STD__IO::check_exit();
        if (!_chpBuffer || _pszMaxLength == 0)
            return;

        std::ptrsize_t length = 0;

        while (length + 1 < _pszMaxLength)
        {
            char ch = std::getc();
            if (HIDDEN__STD__IO::get_stdin_state()->eof && ch == '\0')
                break;

            // Handle Ctrl + C (ASCII 3) - Abort program immediately
            if (ch == 3)
            {
                HIDDEN__STD__IO::trigger_exit();
            }

            // Handle Ctrl + D (ASCII 4) or Ctrl + Z (ASCII 26) - EOF signals
            if (ch == 4 || ch == 26)
            {
                HIDDEN__STD__IO::get_stdin_state()->eof = true;
                break;
            }

            if (ch == '\n')
                break;
            if (ch == '\r')
                continue;

            // Handle Backspace (\b) and DEL (127) control characters
            if (ch == '\b' || ch == 127)
            {
                if (length > 0)
                {
                    length--;
                }
                continue;
            }

            // Handle ANSI Escape sequences (e.g., arrow keys starting with ESC / 27)
            if (ch == 27)
            {
                char next1 = std::getc();
                if (next1 == '[')
                {
                    char next2 = std::getc();
                    static_cast<void>(next2); // Consume sequence suffix safely
                }
                continue;
            }

            // Ignore other non-printable control codes except tab
            if (ch < 32 && ch != '\t')
            {
                continue;
            }

            _chpBuffer[length++] = ch;
        }

        _chpBuffer[length] = '\0';
    } // void std::gets(char *const _chpBuffer, std::ptrsize_t _pszMaxLength)

    /**
     * Reads dynamically from stdin safely until a newline or EOF, handling control sequences and signals, returning a heap-allocated char *[cite: 11]
     **/
    inline char *readDynamic()
    {
        HIDDEN__STD__IO::check_exit();
        std::size_t capacity = 256;
        std::size_t length   = 0;

        char *buffer = static_cast<char *>(std::allocateMemory(capacity));

        if (!buffer)
            return nullptr;

        while (true)
        {
            char ch = std::getc();

            if (HIDDEN__STD__IO::get_stdin_state()->eof && ch == '\0')
                break;

            // Handle Ctrl + C (ASCII 3) - Abort program immediately
            if (ch == 3)
            {
                std::freeMemory(buffer);
                HIDDEN__STD__IO::trigger_exit();
            }

            // Handle Ctrl + D (ASCII 4) or Ctrl + Z (ASCII 26) - EOF signals
            if (ch == 4 || ch == 26)
            {
                HIDDEN__STD__IO::get_stdin_state()->eof = true;
                break;
            }

            if (ch == '\r')
                continue;

            if (ch == '\n')
                break;

            // Handle Backspace (\b) and DEL (127) control characters
            if (ch == '\b' || ch == 127)
            {
                if (length > 0)
                {
                    length--;
                }
                continue;
            }

            // Handle ANSI Escape sequences (starting with ESC / 27)
            if (ch == 27)
            {
                char next1 = std::getc();
                if (next1 == '[')
                {
                    char next2 = std::getc();
                    static_cast<void>(next2);
                }
                continue;
            }

            // Ignore other non-printable control codes except tab
            if (ch < 32 && ch != '\t')
            {
                continue;
            }

            if (length + 1 >= capacity)
            {
                std::size_t newCapacity = capacity * 2;

                char *newBuffer = static_cast<char *>(
                    std::reallocateMemory(buffer, newCapacity)
                );

                if (!newBuffer)
                {
                    std::freeMemory(buffer);
                    return nullptr;
                }

                buffer   = newBuffer;
                capacity = newCapacity;
            }

            buffer[length++] = ch;
        }

        buffer[length] = '\0';

        return buffer;
    } // char *std::readDynamic()

    /**
     * Puts a string to stdout with buffering and automatic flush
     **/
    inline void puts(
        const char *const _chpString
    )
    {
        HIDDEN__STD__IO::check_exit();
        if (!_chpString) return;
        std::write_stdout(_chpString, std::_chpLength(_chpString));
        HIDDEN__STD__IO::flush_stdout_internal();
    } // inline void std::puts(const char *const _chpString)

    /**
     * Puts a character to stdout 
     **/
    inline void putc(
        const char _chChar
    )
    {
        HIDDEN__STD__IO::check_exit();
        std::write_stdout(&_chChar, 1);
    } // inline void std::putc(const char _chChar)

    /**
     * Puts a string to stdout with buffering, automatic flush, and a line feed
     **/
    inline void putsLine(
        const char *const _chpString
    )
    {
        HIDDEN__STD__IO::check_exit();
        if (!_chpString) return;
        std::write_stdout(_chpString, std::_chpLength(_chpString));
        std::putc('\n');
        HIDDEN__STD__IO::flush_stdout_internal();
    } // inline void std::putsLine(const char *const _chpString)

    /**
     * Puts a string to stderr safely
     **/
    inline void errputs(
        const char *const _chpString
    )
    {
        HIDDEN__STD__IO::check_exit();
        if (!_chpString) return;
        std::write_stderr(_chpString, std::_chpLength(_chpString));
    } // inline void std::errputs(const char *const _chpString)

    /**
     * Puts a character to stderr
     **/
    inline void errputc(
        const char _chChar
    )
    {
        HIDDEN__STD__IO::check_exit();
        std::write_stderr(&_chChar, 1);
    } // inline void std::errputc(const char _chChar)


    /**
     * Puts a string to stderr with buffering, automatic flush, and a line feed
     **/
    inline void errputsLine(
        const char *const _chpString
    )
    {
        HIDDEN__STD__IO::check_exit();
        if (!_chpString) return;
        std::write_stderr(_chpString, std::_chpLength(_chpString));
        std::errputc('\n');
    } // inline void std::errputsLine(const char *const _chpString)

    inline char *promptRead(const char *const _chpPrompt)
    {
        HIDDEN__STD__IO::check_exit();
        if (_chpPrompt)
            std::puts(_chpPrompt);
        return std::readDynamic();
    }

} // namespace std

#endif // #ifndef __IO_HP