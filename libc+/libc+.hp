// libc+.hp

#ifndef _LIBCP_HP
#define _LIBCP_HP

#ifdef _WIN32
#include <windows.h>
#elif defined(__APPLE__)
#include <TargetConditionals.h>
#else
#include <unistd.h>
#endif // #ifdef _WIN32

#include <io>
#include <types>

namespace std
{

    enum OS
    {
        Windows,
        Linux,
        MacOS,
        FreeBSD,
        OpenBSD,
        NetBSD,
        Android,
        IOS,
        Unknown
    } // enum OS

    enum Arch
    {
        X86,
        X86_64,
        AArch64,
        ARM,
        RISCV32,
        RISCV64,
        LoongArch64,
        PPC64,
        S390X,
        Wasm32,
        Wasm64,
        Unknown
    } // enum Arch
    
    enum Endian
    {
        Little,
        Big
    } // enum Endian

    struct Platform
    {
        std::OS __os;
        std::Arch __arch;
        std::Endian __endian;
        std::size_t __ptr_size;

        std::OS os(Platform *self)
        {
            return self->__os;
        }

        std::Arch arch(Platform *self)
        {
            return self->__arch;
        }

        std::Endian endian(Platform *self)
        {
            return self->__endian;
        }

        std::size_t ptr_size(Platform *self)
        {
            return self->__ptr_size;
        }
    } // struct Platform
}

namespace std
{
    void hello()
    {
        std::write_stdout("Hello!\n", 7 /* because lengthWithNull - 1 */);
    } // void std::hello()

    std::Platform platform()
    {
        std::Platform p;

        /* ---------------- OS ---------------- */

    #if defined(_WIN32) || defined(_WIN64)
        p.__os = std::OS::Windows;

    #elif defined(__ANDROID__)
        p.__os = std::OS::Android;

    #elif defined(__APPLE__)
        #if defined(TARGET_OS_IPHONE) && TARGET_OS_IPHONE
            p.__os = std::OS::IOS;
        #else
            p.__os = std::OS::MacOS;
        #endif

    #elif defined(__linux__)
        p.__os = std::OS::Linux;

    #elif defined(__FreeBSD__)
        p.__os = std::OS::FreeBSD;

    #elif defined(__OpenBSD__)
        p.__os = std::OS::OpenBSD;

    #elif defined(__NetBSD__)
        p.__os = std::OS::NetBSD;

    #else
        p.__os = std::OS::Unknown;
    #endif


        /* -------------- Architecture -------------- */

    #if defined(__x86_64__) || defined(_M_X64)
        p.__arch = std::Arch::X86_64;

    #elif defined(__i386__) || defined(_M_IX86)
        p.__arch = std::Arch::X86;

    #elif defined(__aarch64__) || defined(_M_ARM64)
        p.__arch = std::Arch::AArch64;

    #elif defined(__arm__) || defined(_M_ARM)
        p.__arch = std::Arch::ARM;

    #elif defined(__riscv) && (__riscv_xlen == 64)
        p.__arch = std::Arch::RISCV64;

    #elif defined(__riscv) && (__riscv_xlen == 32)
        p.__arch = std::Arch::RISCV32;

    #elif defined(__loongarch64)
        p.__arch = std::Arch::LoongArch64;

    #elif defined(__powerpc64__)
        p.__arch = std::Arch::PPC64;

    #elif defined(__s390x__)
        p.__arch = std::Arch::S390X;

    #elif defined(__wasm64__)
        p.__arch = std::Arch::Wasm64;

    #elif defined(__wasm32__)
        p.__arch = std::Arch::Wasm32;

    #else
        p.__arch = std::Arch::Unknown;
    #endif


        /* ---------------- Endianness ---------------- */

    #if defined(__BYTE_ORDER__) && defined(__ORDER_LITTLE_ENDIAN__) && defined(__ORDER_BIG_ENDIAN__)

        #if __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__
            p.__endian = std::Endian::Little;
        #else
            p.__endian = std::Endian::Big;
        #endif

    #elif defined(_WIN32)

        /* Windows only targets little-endian architectures. */
        p.__endian = std::Endian::Little;

    #else

        /* Fallback: runtime detection */
        {
            unsigned int value = 1;

            if (*static_cast<unsigned char *>(&value))
                p.__endian = std::Endian::Little;
            else
                p.__endian = std::Endian::Big;
        }

    #endif

        p.__ptr_size = CMPL__PTR_SIZE;

        return p;
    } // std::Platform std::platform()
} // namespace std

#endif // #ifndef _LIBCP_HP