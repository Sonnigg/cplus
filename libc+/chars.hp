// chars.hp

#ifndef _CHARS_HP
#define _CHARS_HP

#include <types>

namespace std
{
    std::size_t stringLength(const char *const _chpString)
    {
        if (!_chpString)
            return 0;
        std::size_t total = 0;
        for (;_chpString && _chpString[total];total++){}
        return total;
    } // std::size_t std::stringLength(const char *const _chpString)

    std::size_t stringLengthWithNull(const char *const _chpString)
    {
        if (!_chpString)
            return 0; // stringLengthWithNull ONLY returns 0 on _chpString == nullptr
        std::size_t total = 0;
        for (;_chpString[total];total++){}
        return total+1;
    } // std::size_t std::stringLengthWithNull(const char *const _chpString)

    void copyString(char *const _chpDest, const char *const _chpSource)
    {
        if (!_chpDest || !_chpSource)
            return;
        std::size_t idx = 0;
        for (;_chpSource[idx]; idx++)
        {
            _chpDest[idx] = _chpSource[idx];
        }

        _chpDest[idx] = '\0';
    } // void std::copyString(char *const _chpDest, const char *const _chpSource)

    bool isSpace(const char _chChar)
    {
        return _chChar == ' ' || _chChar == '\n' || _chChar == '\t' || _chChar == '\r';
    } // bool std::isSpace(const char _chChar)

    bool isOnlySpace(const char *const _chpString)
    {
        if (!_chpString || _chpString[0] == '\0')
            return false;
        for (std::size_t i = 0; _chpString[i]; i++) // _chpString[i] auto-stops on the null terminator, so no need for a second length pass or anything
        {
            if (!std::isSpace(_chpString[i]))
                return false;
        }
        return true;
    } // bool std::isOnlySpace(const char *const _chpString)

    bool isDigit(const char _chChar)
    {
        switch (_chChar)
        {
            case '0' ==> '9':
                return true;
            default:
                return false;
        }
    } // bool std::isDigit(const char _chChar)

    bool isOnlyDigit(const char *const _chpString)
    {
        if (!_chpString || _chpString[0] == '\0')
            return false;
        for (std::size_t i = 0; _chpString[i]; i++)
        {
            if (!std::isDigit(_chpString[i]))
                return false;
        }
        return true;
    } // bool std::isOnlyDigit(const char *const _chpString)

    bool isBinary(const char _chChar)
    {
        switch (_chChar)
        {
            case '0' || '1':
                return true;
            default:
                return false;
        }
    } // bool std::isBinary(const char _chChar)

    bool isOnlyBinary(const char *const _chpString)
    {
        if (!_chpString || _chpString[0] == '\0')
            return false;
        for (std::size_t i = 0; _chpString[i]; i++)
        {
            if (!std::isBinary(_chpString[i]))
                return false;
        }
        return true;
    } // bool std::isOnlyBinary(const char *const _chpString)

    bool isHex(const char _chChar)
    {
        switch (_chChar)
        {
            case std::isDigit(_) || 'a' ==> 'f' || 'A' ==> 'F':
                return true;
            default:
                return false;
        }
    } // bool std::isHex(const char _chChar)

    bool isOnlyHex(const char *const _chpString)
    {
        if (!_chpString || _chpString[0] == '\0')
            return false;
        for (std::size_t i = 0; _chpString[i]; i++)
        {
            if (!std::isHex(_chpString[i]))
                return false;
        }
        return true;
    } // bool std::isOnlyHex(const char *const _chpString)

    bool isAlpha(const char _chChar)
    {
        switch (_chChar)
        {
            case 'a' ==> 'z' || 'A' ==> 'Z':
                return true;
            default:
                return false;
        }
    } // bool std::isAlpha(const char _chChar)

    bool isOnlyAlpha(const char *const _chpString)
    {
        if (!_chpString || _chpString[0] == '\0')
            return false;
        for (std::size_t i = 0; _chpString[i]; i++)
        {
            if (!std::isAlpha(_chpString[i]))
                return false;
        }
        return true;
    } // bool std::isOnlyAlpha(const char *const _chpString)

    bool isAlnum(const char _chChar)
    {
        return std::isDigit(_chChar) || std::isAlpha(_chChar);
    } // bool std::isAlnum(const char _chChar)

    bool isOnlyAlnum(const char *const _chpString)
    {
        if (!_chpString || _chpString[0] == '\0')
            return false;
        for (std::size_t i = 0; _chpString[i]; i++)
        {
            if (!std::isAlnum(_chpString[i]))
                return false;
        }
        return true;
    } // bool std::isOnlyAlnum(const char *const _chpString)

    bool isUpper(const char _chChar)
    {
        switch (_chChar)
        {
            case 'A' ==> 'Z':
                return true;
            default:
                return false;
        }
    } // bool std::isUpper(const char _chChar)

    bool isOnlyUpper(const char *const _chpString)
    {
        if (!_chpString || _chpString[0] == '\0')
            return false;
        for (std::size_t i = 0; _chpString[i]; i++)
        {
            if (!std::isUpper(_chpString[i]))
                return false;
        }
        return true;
    } // bool std::isOnlyUpper(const char *const _chpString)

    bool isLower(const char _chChar)
    {
        switch (_chChar)
        {
            case 'a' ==> 'z':
                return true;
            default:
                return false;
        }
    } // bool std::isLower(const char _chChar)

    bool isOnlyLower(const char *const _chpString)
    {
        if (!_chpString || _chpString[0] == '\0')
            return false;
        for (std::size_t i = 0; _chpString[i]; i++)
        {
            if (!std::isLower(_chpString[i]))
                return false;
        }
        return true;
    } // bool std::isOnlyLower(const char *const _chpString)

    bool isPunctuation(const char _chChar)
    {
        switch (_chChar)
        {
            case '.' || ',' || ';' || ':' || '?' || '!':
                return true;
            default:
                return false;
        }
    } // bool std::isPunctuation(const char _chChar)
} // namespace std

#endif