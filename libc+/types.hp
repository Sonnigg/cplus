    struct i8 {
        std::int8_t val;

        static i8 fromUInt(std::uint64_t v) {
            return i8 {
                val: static_cast<std::int8_t>(v)
            };
        }

        static i8 fromInt(std::int64_t v) {
            return i8 {
                val: static_cast<std::int8_t>(v)
            };
        }

        static i8 fromChars(const char *const string)
        {
            if (!string || !string[0])
                return i8 {val: 0};

            std::size_t i = 0;
            bool negative = false;

            if (string[0] == '-')
            {
                negative = true;
                i = 1;

                if (!string[i])
                    return i8 {val: 0};
            }

            std::int64_t result = 0;

            for (; string[i]; i++)
            {
                if (!(string[i] >= '0' && string[i] <= '9'))
                    return i8 {val: 0};

                std::int64_t digit =
                    static_cast<std::int64_t>(string[i] - '0');

                result = result * 10 + digit;
            }

            if (negative)
                result = -result;

            return i8 {val: result};
        }
    }
    
