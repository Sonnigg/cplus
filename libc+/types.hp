// types.hp

#ifndef _TYPES_HP
#define _TYPES_HP

namespace std
{
    /*
        Integer and boolN types
    */
    typedef unsigned char       uint8_t;  // max: 2^8  - 1
    typedef unsigned short      uint16_t; // max: 2^16 - 1
    typedef unsigned int        uint32_t; // max: 2^32 - 1
    typedef unsigned long long  uint64_t; // max: 2^64 - 1

    typedef signed char         int8_t;   // min: -(2^7 ), max: 2^7  - 1
    typedef signed short        int16_t;  // min: -(2^15), max: 2^15 - 1
    typedef signed int          int32_t;  // min: -(2^31), max: 2^31 - 1
    typedef signed long long    int64_t;  // min: -(2^63), max: 2^63 - 1

    typedef uint64_t bool8_t;
    typedef uint32_t bool4_t;
    typedef uint16_t bool2_t;
    typedef uint8_t  bool1_t;

    bool isNull(void *const ptr)
    {
        return ptr == nullptr;
    }

    /*
        Pointer-sized types
    */
#if CMPL__PTR_SIZE == 8
    typedef uint64_t ptrsize_t;
    typedef int64_t  sptrsize_t;

#elif CMPL__PTR_SIZE == 4
    typedef uint32_t ptrsize_t;
    typedef int32_t  sptrsize_t;

#elif CMPL__PTR_SIZE == 2
    typedef uint16_t ptrsize_t;
    typedef int16_t  sptrsize_t;

#endif
    typedef ptrsize_t  size_t;
    typedef sptrsize_t ssize_t;

    struct u8 {
        std::uint8_t val;

        static u8 fromUInt(std::uint64_t v) {
            return u8 {
                val: static_cast<std::uint8_t>(v)
            };
        }

        static u8 fromInt(std::int64_t v) {
            return u8 {
                val: static_cast<std::uint8_t>(v)
            };
        }

        static u8 fromChars(const char *const string)
        {
            if (!string || !string[0])
                return u8 {val: 0};

            std::uint64_t result = 0;

            for (std::size_t i = 0; string[i]; i++)
            {
                if (!(string[i] >= '0' && string[i] <= '9'))
                    return u8 {val: 0};

                std::uint64_t digit =
                    static_cast<std::uint64_t>(string[i] - '0');

                result = result * 10 + digit;
            }

            return u8 {val: result};
        }
    }

