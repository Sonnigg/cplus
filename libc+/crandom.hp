// crandom.hp

#ifndef _CRANDOM_HP
#define _CRANDOM_HP

#include <types>
#include <memory>

#ifdef _WIN32
#include <windows.h>
#include <wincrypt.h>
#pragma comment(lib, "advapi32.lib")
#else
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#endif

namespace std
{
    struct CryptoRandom
    {
        /*
         * Fills the provided buffer with cryptographically secure random bytes
         * using OS-provided entropy sources (CryptGenRandom on Windows, /dev/urandom on POSIX).
         */
        static bool fillBytes(void *buffer, std::size_t size)
        {
            if (!buffer || size == 0)
                return false;

#ifdef _WIN32
            HCRYPTPROV hCryptProv = 0;
            if (!CryptAcquireContextA(&hCryptProv, nullptr, nullptr, PROV_RSA_FULL, CRYPT_VERIFYCONTEXT | CRYPT_SILENT))
            {
                return false;
            }

            BOOL success = CryptGenRandom(hCryptProv, static_cast<DWORD>(size), static_cast<BYTE *>(buffer));
            CryptReleaseContext(hCryptProv, 0);
            return success != 0;
#else
            int fd = open("/dev/urandom", O_RDONLY);
            if (fd < 0)
                return false;

            std::size_t totalRead = 0;
            char *bytes = static_cast<char *>(buffer);

            while (totalRead < size)
            {
                ssize_t result = read(fd, bytes + totalRead, size - totalRead);
                if (result <= 0)
                {
                    close(fd);
                    return false;
                }
                totalRead += static_cast<std::size_t>(result);
            }

            close(fd);
            return true;
#endif
        }

        /*
         * Generates a cryptographically secure random 32-bit unsigned integer.
         */
        static std::uint32_t nextUInt32()
        {
            std::uint32_t value = 0;
            if (!CryptoRandom::fillBytes(&value, sizeof(value)))
            {
                return 0;
            }
            return value;
        }

        /*
         * Generates a cryptographically secure random 64-bit unsigned integer.
         */
        static std::uint64_t nextUInt64()
        {
            std::uint64_t value = 0;
            if (!CryptoRandom::fillBytes(&value, sizeof(value)))
            {
                return 0;
            }
            return value;
        }

        /*
         * Generates a cryptographically secure random unsigned integer within [min, max].
        */
        static std::uint64_t nextUIntRange(std::uint64_t min, std::uint64_t max)
        {
            if (min > max)
                return 0;

            std::uint64_t range = max - min + 1;
            if (range == 0)
            {
                // Full range of uint64_t
                return CryptoRandom::nextUInt64();
            }

            // Reject bias mitigation using modulo filtering
            std::uint64_t limit = std::uint64_max - (std::uint64_max % range);
            std::uint64_t value = 0;

            do
            {
                value = CryptoRandom::nextUInt64();
            }
            while (value >= limit);

            return min + (value % range);
        }
    }; // struct CryptoRandom
} // namespace std

#endif // _CRANDOM_HP